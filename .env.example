# Server Configuration
PORT=3000
NODE_ENV=development

# JWT & Session Security
SESSION_SECRET=your_super_secret_jwt_key_min_32_characters_here

# Database Configuration (SQLite by default, compatible with PostgreSQL)
DATABASE_URL=data/database.sqlite

# EasyPaisa API Credentials (Section 31 & 69)
EASYPAISA_API_KEY=
EASYPAISA_SECRET=
EASYPAISA_STORE_ID=

# JazzCash API Credentials (Section 31 & 69)
JAZZCASH_API_KEY=
JAZZCASH_SECRET=
JAZZCASH_MERCHANT_ID=

# USDT Web3 / Payment Provider (Section 34 & 69)
USDT_PROVIDER_API_KEY=
USDT_TRC20_WALLET_ADDRESS=TQn9Y2khEsLJW1ChVWFMSMeSTow5KAnsP5

# Payment Webhook HMAC Verification Secret (Section 86)
WEBHOOK_SECRET=your_production_webhook_secret_here

# Object Storage for Private Streaming (Optional, Section 42 & 69)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Email Notification Provider (Section 53 & 69)
EMAIL_API_KEY=
